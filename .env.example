PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dental_bot?schema=public"

# WhatsApp Provider Configuration ('waboxapp' | 'flaresend' | 'meta')
WHATSAPP_PROVIDER="flaresend"

# Waboxapp WhatsApp Configuration
# Use the connected WhatsApp account phone number in international format (digits only).
WABOXAPP_API_TOKEN="your_waboxapp_api_token"
WABOXAPP_PHONE_NUMBER="254712345678"
WABOXAPP_BASE_URL="https://www.waboxapp.com/api"

# Flaresend WhatsApp Configuration
FLARESEND_API_KEY="your_flaresend_instance_api_key"
FLARESEND_BASE_URL="https://api.flaresend.com"

# Meta WhatsApp Cloud API Config (Preserved for easy switching)
WEBHOOK_VERIFY_TOKEN="your_meta_webhook_verify_token"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_meta_access_token"
WHATSAPP_GRAPH_API_VERSION="v20.0"

# LLM Abstraction Configuration ('gemini' | 'openai')
LLM_PROVIDER_NAME="gemini"
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.5-flash-lite"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# Voice Transcription Configuration ('elevenlabs' | 'AssemblyAI')
ASSEMBLY_AI_API_KEY="assembly_ai"

# Admin Google OAuth Configuration
# The redirect URI must match exactly: http://localhost:3000/admin/auth/google/callback for local dev,
# or https://your-domain.com/admin/auth/google/callback in production.
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_REDIRECT_URI="https://infamous-spooky-monster-q4957gxgv4536xqg-3000.app.github.dev/admin/auth/google/callback"

# Booking Configuration
BOOKING_TIMEZONE="Africa/Nairobi"
BOOKING_OPEN_DAYS="1,2,3,4,5,6"
BOOKING_OPEN_TIME="08:00"
BOOKING_CLOSE_TIME="17:00"
BOOKING_SLOT_MINUTES="30"
BOOKING_DRAFT_TTL_MINUTES="30"
